# VARUNA GRID — copy to .env and fill in. Never commit .env.

# ── Infrastructure ──
USE_POSTGRES=false
DATABASE_URL=postgresql+psycopg2://varuna:varuna@localhost:5432/varuna

USE_MINIO=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=varuna
MINIO_SECRET_KEY=varuna_secret
MINIO_BUCKET=varuna
MINIO_SECURE=false

# ── Paths ──
DATA_DIR=data
FORCING_DIR=data/forcing
SCENE_DIR=data/scenes
CACHE_DIR=data/cache
OUTPUT_DIR=data/output
MODEL_DIR=models
NETRA_MODEL_PATH=models/netra_unet.torchscript
CHHAYA_MODEL_PATH=models/chhaya_xview3.pt
CALIBRATION_MODEL_PATH=models/nyaya_isotonic.joblib

# ── PRATIVARTAN (Phi field) ──
PHI_N_PARTICLES=2000
PHI_N_ENSEMBLE=50
PHI_DT_SECONDS=900
PHI_GRID_NX=200
PHI_GRID_NY=200
PHI_TIME_BIN_HOURS=1.0
PHI_BACKWARD_MARGIN=1.3

# ── NYAYA ──
NYAYA_CORRIDOR_KM=5.0
NYAYA_INCONCLUSIVE_ENTROPY=0.85
NYAYA_MIN_POSTERIOR_FOR_NAME=0.35
AIS_WINDOW_BEFORE_HOURS=48
AIS_WINDOW_AFTER_HOURS=6

# ── NETRA ──
NETRA_TILE_SIZE=512
NETRA_CONFIDENCE_THRESHOLD=0.5
NETRA_WIND_GATE_MS=3.0

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DEMO_MODE=false

# ── External data accounts (not read by config.py; used by fetch scripts) ──
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

CDSE_USERNAME=
CDSE_PASSWORD=

