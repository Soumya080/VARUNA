# ═══════════════════════════════════════════════
#  VARUNA GRID — .gitignore
# ═══════════════════════════════════════════════

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# ── Virtual Environments ──
venv/
env/
.venv/
.env
*.env
!.env.example

# ── Credentials (CDS API / Copernicus / any local rc files) ──
.cdsapirc
*.cdsapirc
.copernicusmarine/
.netrc

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ── Data (large files — do not commit) ──
data/cache/
data/forcing/*.nc
data/forcing/*.grib
data/scenes/*.tif
data/scenes/*.tiff
data/scenes/*.safe
data/scenes/*.zip
data/output/
data/raw/**
!data/raw/**/.gitkeep
data/bronze/**
!data/bronze/**/.gitkeep
data/silver/**
!data/silver/**/.gitkeep
data/gold/**
!data/gold/**/.gitkeep
data/manifests/**
!data/manifests/**/.gitkeep
*.npz
*.npy

# ── Models & Artifacts (large binary weights, runs — do not commit) ──
models/*.pt
models/*.pth
models/*.torchscript
models/*.onnx
models/*.joblib
models/*.pkl
models/*.h5
artifacts/models/**
!artifacts/models/**/.gitkeep
artifacts/checkpoints/**
!artifacts/checkpoints/**/.gitkeep
artifacts/experiments/**
!artifacts/experiments/**/.gitkeep
artifacts/reports/**
!artifacts/reports/**/.gitkeep

# ── Experiment results (large CSVs, plots) ──
experiments/go_nogo/results/
experiments/go_nogo/__pycache__/

# ── Docker ──
docker-compose.override.yml

# ── Logs ──
*.log
logs/

# ── Jupyter ──
.ipynb_checkpoints/
*.ipynb

# ── pytest ──
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# ── mypy ──
.mypy_cache/

# ── Node ──
node_modules/

# ── Linter / Tool Caches ──
.ruff_cache/
.hypothesis/

# ── User notes / vaults (not project code) ──
MEM/

# ── Misc ──
*.bak
*.tmp
*.temp
.agents/

# Playwright browser binaries (702 MB) — reinstall with:
#   playwright install chromium
.playwright-browsers/

# Test/E2E output artifacts
reports/product/_downloads/
reports/product/_judge_downloads/

# --- MC20 demo event: the ONE shippable slice of data/gold ---------------
# data/gold is 131 GB and stays ignored above. This single event directory is
# 19 MB and is read at request time by the CHHAYA endpoint, so it must ship or
# a fresh clone has no SAR to investigate. Parents are re-included step by
# step because git cannot un-ignore a file inside an excluded directory.
!data/gold/events/
!data/gold/events/mc20_v0_1/
!data/gold/events/mc20_v0_1/**
!data/gold/events/mc20_v0_1/**/*.npy
